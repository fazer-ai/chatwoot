#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# enterprise/ stays identical to upstream; the fork's changes go in fazer_ai_ee/
sh bin/validate_enterprise_parity --staged || exit 1

# lint js and vue files
npx --no-install lint-staged

# lint only staged ruby files
git diff --name-only --cached | xargs ls -1 2>/dev/null | grep '\.rb$' | xargs bundle exec rubocop --force-exclusion

