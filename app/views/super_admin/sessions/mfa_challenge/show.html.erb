<!DOCTYPE html>
<html>
  <head>
    <title>SuperAdmin | <%= ENV.fetch('FRONTEND_URL', 'Chatwoot').sub(%r{https?://}, '') %></title>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
  </head>
  <body>
    <div class="h-full w-full antialiased">
      <main class="flex flex-col bg-woot-25 min-h-screen w-full py-20 sm:px-6 lg:px-8 dark:bg-slate-900">
        <section class="max-w-5xl mx-auto">
          <img src="/brand-assets/logo.svg" alt="Chatwoot" class="mx-auto h-8 w-auto block dark:hidden">
          <img src="/brand-assets/logo_dark.svg" alt="Chatwoot" class="mx-auto h-8 w-auto hidden dark:block">
          <h2 class="mt-6 text-center text-3xl font-medium text-slate-900 dark:text-woot-50">
            Two-factor verification
          </h2>
          <p class="mt-2 text-center text-sm text-slate-600 dark:text-woot-200">
            Enter the 6-digit code from your authenticator app to continue.
          </p>
        </section>
        <section class="bg-white shadow sm:mx-auto mt-11 sm:w-full sm:max-w-lg dark:bg-slate-800 p-11 sm:shadow-lg sm:rounded-lg mb-8 mt-15">
          <%= form_with url: super_admin_sessions_mfa_challenge_path, method: :post, local: true do %>
            <% if flash[:error].present? %>
              <div data-alert class="rounded-md bg-red-500 p-4 text-white text-sm mb-5"><%= flash[:error] %></div>
            <% end %>
            <div class="mb-5">
              <label for="otp_code" class="flex justify-between text-sm font-medium leading-6 text-slate-900 dark:text-white">
                Authenticator code
              </label>
              <div class="mt-1">
                <input type="text" id="otp_code" name="otp_code" inputmode="numeric" autocomplete="one-time-code" autofocus minlength="6" maxlength="6" pattern="\d{6}" placeholder="123456" class="block w-full rounded-md border-0 px-3 py-3 appearance-none shadow-sm ring-1 ring-inset text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-woot-500 sm:text-sm sm:leading-6 outline-none dark:bg-slate-700 dark:ring-slate-600 dark:focus:ring-woot-500 ring-slate-200">
              </div>
            </div>
            <details class="mb-5">
              <summary class="text-sm text-slate-600 dark:text-woot-200 cursor-pointer">Use a backup code instead</summary>
              <div class="mt-3">
                <input type="text" id="backup_code" name="backup_code" autocomplete="off" placeholder="Backup code" class="block w-full rounded-md border-0 px-3 py-3 appearance-none shadow-sm ring-1 ring-inset text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-woot-500 sm:text-sm sm:leading-6 outline-none dark:bg-slate-700 dark:ring-slate-600 dark:focus:ring-woot-500 ring-slate-200">
              </div>
            </details>
            <button type="submit" class="flex items-center w-full justify-center rounded-md bg-woot-500 py-3 px-3 text-base font-medium text-white shadow-sm hover:bg-woot-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-woot-500 cursor-pointer">
              <span>Verify</span>
            </button>
          <% end %>
          <%= button_to 'Cancel', super_admin_logout_path, method: :get, class: 'mt-4 w-full text-center text-sm text-slate-500 hover:text-slate-700 underline bg-transparent border-0 cursor-pointer' %>
        </section>
      </main>
    </div>
  </body>
</html>
