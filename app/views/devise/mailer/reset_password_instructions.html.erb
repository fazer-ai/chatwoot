<p><%= t('mailer.devise.reset_password_instructions.greeting_html', name: @resource.name) %></p>

<p><%= t('mailer.devise.reset_password_instructions.body_html') %></p>

<% reset_password_params = { reset_password_token: @token } %>
<% reset_password_params[:route_url] = params[:redirect_url] if params[:redirect_url].present? %>
<% reset_password_params[:sso_account_id] = params[:sso_account_id] if params[:sso_account_id].present? %>
<p><%= link_to t('mailer.devise.reset_password_instructions.action'), frontend_url('auth/password/edit', **reset_password_params) %></p>

<p style="color: #999999; font-size: 12px;"><%= t('mailer.devise.reset_password_instructions.copy_paste_html') %> <%= frontend_url('auth/password/edit', **reset_password_params) %></p>

<p><%= t('mailer.devise.reset_password_instructions.ignore_html') %></p>
<p><%= t('mailer.devise.reset_password_instructions.no_change_html') %></p>
