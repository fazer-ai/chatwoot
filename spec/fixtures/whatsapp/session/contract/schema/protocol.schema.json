{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fazer.ai/schemas/whatsapp-connector/v1/protocol.schema.json",
  "title": "fazer.ai WhatsApp session protocol v1",
  "description": "Canonical wire contract shared by the Go connector (native provider) and the Rails session layer (native + uazapi backends). Frames are validated after decoding: numeric fields are numbers here even though Redis stream fields are transported as strings.",
  "oneOf": [
    { "$ref": "#/definitions/event" },
    { "$ref": "#/definitions/command" },
    { "$ref": "#/definitions/reply" }
  ],
  "definitions": {
    "protocol_version": { "type": "integer", "const": 1 },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "digits": { "type": "string", "pattern": "^[0-9]+$" },
    "message_id": { "type": "string", "minLength": 1, "maxLength": 128 },

    "address": {
      "type": "object",
      "description": "A WhatsApp addressable entity. `id` never carries the @server suffix, the device or the agent part.",
      "properties": {
        "kind": { "enum": ["phone", "lid", "group", "newsletter", "broadcast", "status"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },

    "party": {
      "type": "object",
      "description": "The human/business behind an address. At least one of phone or lid is always present.",
      "properties": {
        "phone": { "$ref": "#/definitions/digits" },
        "lid": { "$ref": "#/definitions/digits" },
        "push_name": { "type": ["string", "null"] },
        "verified_name": { "type": ["string", "null"] }
      },
      "anyOf": [{ "required": ["phone"] }, { "required": ["lid"] }],
      "additionalProperties": true
    },

    "quarantine": {
      "type": "object",
      "properties": {
        "strikes": { "type": "integer", "minimum": 0 },
        "until": { "$ref": "#/definitions/timestamp_ms" }
      },
      "required": ["strikes"],
      "additionalProperties": true
    },

    "ban": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["temporary", "permanent"] },
        "expires_at": { "$ref": "#/definitions/timestamp_ms" },
        "reason": { "type": ["string", "null"] }
      },
      "required": ["kind"],
      "additionalProperties": true
    },

    "connection_state": {
      "type": "object",
      "description": "Shape persisted in channel_whatsapp.provider_connection by ConnectionStateWriter.",
      "properties": {
        "connection": { "enum": ["close", "connecting", "reconnecting", "open"] },
        "qr_data_url": { "type": ["string", "null"] },
        "pairing_code": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"], "description": "i18n key suffix under errors.inboxes.channel.provider_connection" },
        "epoch": { "type": "integer", "minimum": 0 },
        "phone_number": { "type": ["string", "null"] },
        "lid": { "type": ["string", "null"] },
        "quarantine": { "oneOf": [{ "$ref": "#/definitions/quarantine" }, { "type": "null" }] },
        "ban": { "oneOf": [{ "$ref": "#/definitions/ban" }, { "type": "null" }] },
        "reachout_time_lock": { "type": ["object", "null"] },
        "new_chat_cap": { "type": ["object", "null"] }
      },
      "required": ["connection"],
      "additionalProperties": true
    },

    "media_ref": {
      "type": "object",
      "description": "How to fetch the bytes of an inbound media message. `connector_blob` and `url` are fetched over HTTP; `uazapi_message` needs a /message/download round trip.",
      "properties": {
        "kind": { "enum": ["url", "connector_blob", "uazapi_message"] },
        "id": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "headers": { "type": "object" },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "mime": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] },
        "expires_at": { "oneOf": [{ "$ref": "#/definitions/timestamp_ms" }, { "type": "null" }] }
      },
      "required": ["kind"],
      "additionalProperties": true
    },

    "content_text": {
      "type": "object",
      "properties": {
        "type": { "const": "text" },
        "body": { "type": "string" }
      },
      "required": ["type", "body"],
      "additionalProperties": true
    },

    "content_media": {
      "type": "object",
      "properties": {
        "type": { "const": "media" },
        "kind": { "enum": ["image", "video", "audio", "document", "sticker"] },
        "mime": { "type": ["string", "null"] },
        "filename": { "type": ["string", "null"] },
        "caption": { "type": ["string", "null"] },
        "voice_note": { "type": "boolean" },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "duration": { "type": ["integer", "null"], "minimum": 0 },
        "thumbnail": { "type": ["string", "null"], "description": "data: URI, at most 32 KiB" },
        "ref": { "oneOf": [{ "$ref": "#/definitions/media_ref" }, { "type": "null" }] }
      },
      "required": ["type", "kind"],
      "additionalProperties": true
    },

    "content_location": {
      "type": "object",
      "properties": {
        "type": { "const": "location" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "name": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "live": { "type": "boolean" }
      },
      "required": ["type", "latitude", "longitude"],
      "additionalProperties": true
    },

    "content_contacts": {
      "type": "object",
      "properties": {
        "type": { "const": "contacts" },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "display_name": { "type": ["string", "null"] },
              "phone": { "type": ["string", "null"] },
              "vcard": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        }
      },
      "required": ["type", "contacts"],
      "additionalProperties": true
    },

    "content_reaction": {
      "type": "object",
      "description": "Outbound only. Inbound reactions arrive as the message.reaction event.",
      "properties": {
        "type": { "const": "reaction" },
        "target_id": { "$ref": "#/definitions/message_id" },
        "emoji": { "type": "string", "description": "empty string removes the reaction" }
      },
      "required": ["type", "target_id", "emoji"],
      "additionalProperties": true
    },

    "content_rich": {
      "type": "object",
      "description": "Interactive or templated card (template, buttons, list, interactive). Carries the rendered parts as the dashboard shows them; the message preview text is derived from those parts, not sent separately.",
      "properties": {
        "type": { "const": "rich" },
        "kind": { "type": ["string", "null"], "description": "template, interactive, buttons, list or flow" },
        "title": { "type": ["string", "null"] },
        "body": { "type": ["string", "null"] },
        "footer": { "type": ["string", "null"] },
        "buttons": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "url": { "type": ["string", "null"] },
              "phone": { "type": ["string", "null"] }
            },
            "required": ["text"],
            "additionalProperties": true
          }
        },
        "media": {
          "description": "Media in the header of the card, if any.",
          "oneOf": [{ "$ref": "#/definitions/content_media" }, { "type": "null" }]
        }
      },
      "required": ["type"],
      "additionalProperties": true
    },

    "content_unsupported": {
      "type": "object",
      "properties": {
        "type": { "const": "unsupported" },
        "reason": { "enum": ["unknown_type", "undecryptable", "protocol", "empty"] }
      },
      "required": ["type", "reason"],
      "additionalProperties": true
    },

    "content": {
      "oneOf": [
        { "$ref": "#/definitions/content_text" },
        { "$ref": "#/definitions/content_media" },
        { "$ref": "#/definitions/content_location" },
        { "$ref": "#/definitions/content_contacts" },
        { "$ref": "#/definitions/content_reaction" },
        { "$ref": "#/definitions/content_rich" },
        { "$ref": "#/definitions/content_unsupported" }
      ]
    },

    "inbound_message": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/message_id" },
        "chat": { "$ref": "#/definitions/address" },
        "sender": { "oneOf": [{ "$ref": "#/definitions/party" }, { "type": "null" }] },
        "from_me": { "type": "boolean" },
        "timestamp": { "$ref": "#/definitions/timestamp_ms" },
        "content": { "$ref": "#/definitions/content" },
        "quoted_id": { "type": ["string", "null"] },
        "mentions": { "type": "array", "items": { "$ref": "#/definitions/address" } },
        "referral": { "type": ["object", "null"], "description": "Click-to-WhatsApp ad context" },
        "entry_point": { "type": ["object", "null"] },
        "client_ref": { "type": ["string", "null"], "description": "echo correlation token for providers that cannot accept a caller-supplied id" },
        "ephemeral": { "type": ["integer", "null"], "description": "disappearing-message expiration in seconds" },
        "raw": { "type": ["object", "null"], "description": "provider node, kept for the rich parser and for debugging" }
      },
      "required": ["id", "chat", "from_me", "timestamp", "content"],
      "additionalProperties": true
    },

    "group_participant": {
      "type": "object",
      "properties": {
        "party": { "$ref": "#/definitions/party" },
        "role": { "enum": ["member", "admin", "superadmin"] }
      },
      "required": ["party"],
      "additionalProperties": true
    },

    "group_info": {
      "type": "object",
      "properties": {
        "group": { "$ref": "#/definitions/address" },
        "subject": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "owner": { "oneOf": [{ "$ref": "#/definitions/party" }, { "type": "null" }] },
        "created_at": { "oneOf": [{ "$ref": "#/definitions/timestamp_ms" }, { "type": "null" }] },
        "participants": { "type": "array", "items": { "$ref": "#/definitions/group_participant" } },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "announce": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "join_approval": { "type": "boolean" },
        "member_add_mode": { "enum": ["admin_add", "all_member_add"] },
        "picture_url": { "type": ["string", "null"] },
        "has_picture": { "type": ["boolean", "null"] },
        "invite_code": { "type": ["string", "null"] }
      },
      "required": ["group"],
      "additionalProperties": true
    },

    "error_code": {
      "enum": [
        "invalid_payload", "unsupported", "session_not_found", "not_connected", "not_paired",
        "owned_elsewhere", "quarantined", "client_outdated", "rate_limited", "expired", "timeout",
        "media_too_large", "media_unavailable", "recipient_not_on_whatsapp", "group_participant_not_allowed",
        "wa_error", "internal"
      ]
    },

    "error": {
      "type": "object",
      "properties": {
        "code": { "$ref": "#/definitions/error_code" },
        "message": { "type": ["string", "null"] },
        "retryable": { "type": "boolean" }
      },
      "required": ["code"],
      "additionalProperties": true
    },

    "event_frame": {
      "type": "object",
      "description": "One entry of wa:events:<shard>. seq is monotonic per (sid, epoch).",
      "properties": {
        "v": { "$ref": "#/definitions/protocol_version" },
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "sid": { "type": "string", "minLength": 1 },
        "epoch": { "type": "integer", "minimum": 0 },
        "seq": { "type": "integer", "minimum": 0 },
        "ts": { "$ref": "#/definitions/timestamp_ms" },
        "inst": { "type": "string" },
        "payload": { "type": "object" }
      },
      "required": ["v", "id", "type", "sid", "epoch", "seq", "ts", "payload"],
      "additionalProperties": false
    },

    "command_frame": {
      "type": "object",
      "description": "One entry of wa:cmd:<sid> or wa:control. reply_to is the wa:reply:<id> list an RPC answer is pushed to.",
      "properties": {
        "v": { "$ref": "#/definitions/protocol_version" },
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "sid": { "type": "string", "minLength": 1 },
        "ts": { "$ref": "#/definitions/timestamp_ms" },
        "reply_to": { "type": ["string", "null"] },
        "deadline": { "oneOf": [{ "$ref": "#/definitions/timestamp_ms" }, { "type": "null" }] },
        "idempotency_key": { "type": ["string", "null"] },
        "payload": { "type": "object" }
      },
      "required": ["v", "id", "type", "sid", "ts", "payload"],
      "additionalProperties": false
    },

    "reply": {
      "type": "object",
      "description": "Single element pushed to wa:reply:<command_id>.",
      "properties": {
        "v": { "$ref": "#/definitions/protocol_version" },
        "id": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "result": { "type": ["object", "null"] },
        "error": { "oneOf": [{ "$ref": "#/definitions/error" }, { "type": "null" }] }
      },
      "required": ["v", "id", "ok"],
      "additionalProperties": false
    },

    "event": {
      "allOf": [
        { "$ref": "#/definitions/event_frame" },
        {
          "oneOf": [
            { "properties": { "type": { "const": "session.state" }, "payload": { "$ref": "#/definitions/event_session_state" } }, "required": ["type"] },
            { "properties": { "type": { "const": "session.logged_out" }, "payload": { "$ref": "#/definitions/event_session_logged_out" } }, "required": ["type"] },
            { "properties": { "type": { "const": "session.stream_replaced" }, "payload": { "type": "object" } }, "required": ["type"] },
            { "properties": { "type": { "const": "session.temporary_ban" }, "payload": { "$ref": "#/definitions/event_session_temporary_ban" } }, "required": ["type"] },
            { "properties": { "type": { "const": "session.client_outdated" }, "payload": { "type": "object" } }, "required": ["type"] },
            { "properties": { "type": { "const": "session.connect_failure" }, "payload": { "$ref": "#/definitions/event_session_connect_failure" } }, "required": ["type"] },
            { "properties": { "type": { "const": "pairing.qr" }, "payload": { "$ref": "#/definitions/event_pairing_qr" } }, "required": ["type"] },
            { "properties": { "type": { "const": "pairing.code" }, "payload": { "$ref": "#/definitions/event_pairing_code" } }, "required": ["type"] },
            { "properties": { "type": { "const": "pairing.success" }, "payload": { "$ref": "#/definitions/event_pairing_success" } }, "required": ["type"] },
            { "properties": { "type": { "const": "pairing.error" }, "payload": { "$ref": "#/definitions/event_pairing_error" } }, "required": ["type"] },
            { "properties": { "type": { "const": "pairing.passkey_request" }, "payload": { "$ref": "#/definitions/event_pairing_passkey_request" } }, "required": ["type"] },
            { "properties": { "type": { "const": "pairing.passkey_confirmation" }, "payload": { "$ref": "#/definitions/event_pairing_passkey_confirmation" } }, "required": ["type"] },
            { "properties": { "type": { "const": "message.received" }, "payload": { "$ref": "#/definitions/event_message_received" } }, "required": ["type"] },
            { "properties": { "type": { "const": "message.receipt" }, "payload": { "$ref": "#/definitions/event_message_receipt" } }, "required": ["type"] },
            { "properties": { "type": { "const": "message.edited" }, "payload": { "$ref": "#/definitions/event_message_edited" } }, "required": ["type"] },
            { "properties": { "type": { "const": "message.revoked" }, "payload": { "$ref": "#/definitions/event_message_revoked" } }, "required": ["type"] },
            { "properties": { "type": { "const": "message.reaction" }, "payload": { "$ref": "#/definitions/event_message_reaction" } }, "required": ["type"] },
            { "properties": { "type": { "const": "media.download_failed" }, "payload": { "$ref": "#/definitions/event_media_download_failed" } }, "required": ["type"] },
            { "properties": { "type": { "const": "command.failed" }, "payload": { "$ref": "#/definitions/event_command_failed" } }, "required": ["type"] },
            { "properties": { "type": { "const": "chat.presence" }, "payload": { "$ref": "#/definitions/event_chat_presence" } }, "required": ["type"] },
            { "properties": { "type": { "const": "presence.update" }, "payload": { "$ref": "#/definitions/event_presence_update" } }, "required": ["type"] },
            { "properties": { "type": { "const": "contact.picture_changed" }, "payload": { "$ref": "#/definitions/event_contact_picture_changed" } }, "required": ["type"] },
            { "properties": { "type": { "const": "contact.identity_changed" }, "payload": { "$ref": "#/definitions/event_contact_identity_changed" } }, "required": ["type"] },
            { "properties": { "type": { "const": "group.joined" }, "payload": { "$ref": "#/definitions/event_group_joined" } }, "required": ["type"] },
            { "properties": { "type": { "const": "group.updated" }, "payload": { "$ref": "#/definitions/event_group_updated" } }, "required": ["type"] },
            { "properties": { "type": { "const": "group.picture_changed" }, "payload": { "$ref": "#/definitions/event_group_picture_changed" } }, "required": ["type"] },
            { "properties": { "type": { "const": "group.activity" }, "payload": { "$ref": "#/definitions/event_group_activity" } }, "required": ["type"] },
            { "properties": { "type": { "const": "account.reachout_timelock" }, "payload": { "$ref": "#/definitions/event_account_reachout_timelock" } }, "required": ["type"] },
            { "properties": { "type": { "const": "account.new_chat_cap" }, "payload": { "$ref": "#/definitions/event_account_new_chat_cap" } }, "required": ["type"] },
            { "properties": { "type": { "const": "call.offer" }, "payload": { "$ref": "#/definitions/event_call_offer" } }, "required": ["type"] },
            { "properties": { "type": { "const": "call.terminate" }, "payload": { "$ref": "#/definitions/event_call_terminate" } }, "required": ["type"] },
            { "properties": { "type": { "const": "history.sync" }, "payload": { "type": "object" } }, "required": ["type"] },
            { "properties": { "type": { "const": "raw" }, "payload": { "$ref": "#/definitions/event_raw" } }, "required": ["type"] }
          ]
        }
      ]
    },

    "event_session_state": {
      "type": "object",
      "properties": {
        "state": { "enum": ["close", "connecting", "reconnecting", "open"] },
        "reason": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "lid": { "type": ["string", "null"] },
        "quarantine": { "oneOf": [{ "$ref": "#/definitions/quarantine" }, { "type": "null" }] },
        "ban": { "oneOf": [{ "$ref": "#/definitions/ban" }, { "type": "null" }] }
      },
      "required": ["state"],
      "additionalProperties": true
    },
    "event_session_logged_out": {
      "type": "object",
      "properties": {
        "reason": { "type": ["string", "null"] },
        "on_connect": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "event_session_temporary_ban": {
      "type": "object",
      "properties": { "ban": { "$ref": "#/definitions/ban" } },
      "required": ["ban"],
      "additionalProperties": true
    },
    "event_session_connect_failure": {
      "type": "object",
      "properties": {
        "reason": { "type": ["string", "null"] },
        "code": { "type": ["string", "integer", "null"] }
      },
      "additionalProperties": true
    },
    "event_pairing_qr": {
      "type": "object",
      "properties": {
        "png_data_url": { "type": "string", "pattern": "^data:image/png;base64," },
        "expires_in_ms": { "type": "integer", "minimum": 0 }
      },
      "required": ["png_data_url"],
      "additionalProperties": true
    },
    "event_pairing_code": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "minLength": 4 },
        "phone": { "$ref": "#/definitions/digits" }
      },
      "required": ["code"],
      "additionalProperties": true
    },
    "event_pairing_success": {
      "type": "object",
      "properties": {
        "phone": { "$ref": "#/definitions/digits" },
        "lid": { "$ref": "#/definitions/digits" },
        "platform": { "type": ["string", "null"] }
      },
      "required": ["phone"],
      "additionalProperties": true
    },
    "event_pairing_error": {
      "type": "object",
      "properties": {
        "reason": { "type": "string" },
        "message": { "type": ["string", "null"] }
      },
      "required": ["reason"],
      "additionalProperties": true
    },
    "event_pairing_passkey_request": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "public_key": { "type": "object", "description": "WebAuthn PublicKeyCredentialRequestOptions, base64url encoded fields" }
      },
      "required": ["request_id", "public_key"],
      "additionalProperties": true
    },
    "event_pairing_passkey_confirmation": {
      "type": "object",
      "properties": { "code": { "type": "string" } },
      "required": ["code"],
      "additionalProperties": true
    },
    "event_message_received": {
      "type": "object",
      "properties": { "message": { "$ref": "#/definitions/inbound_message" } },
      "required": ["message"],
      "additionalProperties": true
    },
    "event_message_receipt": {
      "type": "object",
      "properties": {
        "chat": { "$ref": "#/definitions/address" },
        "message_ids": { "type": "array", "items": { "$ref": "#/definitions/message_id" }, "minItems": 1 },
        "type": { "enum": ["delivered", "read", "played", "failed"] },
        "participant": { "oneOf": [{ "$ref": "#/definitions/address" }, { "type": "null" }] },
        "error": { "oneOf": [{ "$ref": "#/definitions/error" }, { "type": "null" }] },
        "timestamp": { "$ref": "#/definitions/timestamp_ms" }
      },
      "required": ["chat", "message_ids", "type"],
      "additionalProperties": true
    },
    "event_message_edited": {
      "type": "object",
      "properties": {
        "chat": { "$ref": "#/definitions/address" },
        "sender": { "oneOf": [{ "$ref": "#/definitions/party" }, { "type": "null" }] },
        "message_id": { "$ref": "#/definitions/message_id" },
        "from_me": { "type": "boolean" },
        "content": { "$ref": "#/definitions/content" },
        "timestamp": { "$ref": "#/definitions/timestamp_ms" }
      },
      "required": ["chat", "message_id", "content"],
      "additionalProperties": true
    },
    "event_message_revoked": {
      "type": "object",
      "properties": {
        "chat": { "$ref": "#/definitions/address" },
        "sender": { "oneOf": [{ "$ref": "#/definitions/party" }, { "type": "null" }] },
        "message_id": { "$ref": "#/definitions/message_id" },
        "by": { "enum": ["contact", "self"] },
        "timestamp": { "$ref": "#/definitions/timestamp_ms" }
      },
      "required": ["chat", "message_id", "by"],
      "additionalProperties": true
    },
    "event_message_reaction": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/message_id" },
        "chat": { "$ref": "#/definitions/address" },
        "sender": { "oneOf": [{ "$ref": "#/definitions/party" }, { "type": "null" }] },
        "from_me": { "type": "boolean" },
        "target_id": { "$ref": "#/definitions/message_id" },
        "emoji": { "type": "string" },
        "timestamp": { "$ref": "#/definitions/timestamp_ms" }
      },
