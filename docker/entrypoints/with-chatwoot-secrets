#!/bin/sh
# Loads the deployment's Docker/Swarm secrets into the environment before the service's own
# entrypoint runs.
#
# The assignment is deliberately split from the export. In sh, the exit status of
# `export VAR="$(cmd)"` is that of `export`, not of `cmd`, so under `set -e` an
# unreadable or missing secret would not abort: the variable would be exported empty
# and the container would boot with a blank credential, surfacing much later and far
# from the cause. Assigning first makes the failed `cat` fatal here.
set -eu

# An overriding `entrypoint:` replaces the image's ENTRYPOINT but does not always keep its
# CMD: Docker Compose drops the CMD when a service declares `entrypoint:` without `command:`,
# so `"$@"` would be empty and the container would exit 0 having started nothing. Fail loudly
# here instead of relying on every compose remembering to repeat the command.
if [ "$#" -eq 0 ]; then
  echo "with-chatwoot-secrets: no command given; declare 'command:' next to 'entrypoint:'" >&2
  exit 1
fi

read_secret() {
  cat "/run/secrets/$1"
}

POSTGRES_PASSWORD="$(read_secret chatwoot_postgres_password)"
export POSTGRES_PASSWORD

REDIS_PASSWORD="$(read_secret chatwoot_redis_password)"
export REDIS_PASSWORD

SECRET_KEY_BASE="$(read_secret chatwoot_secret_key_base)"
export SECRET_KEY_BASE

BAILEYS_PROVIDER_DEFAULT_API_KEY="$(read_secret baileys_api_key_v2)"
export BAILEYS_PROVIDER_DEFAULT_API_KEY

exec "$@"
