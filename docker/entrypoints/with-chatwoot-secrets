#!/bin/sh
set -eu

read_secret() {
  cat "/run/secrets/$1"
}

export POSTGRES_PASSWORD="$(read_secret chatwoot_postgres_password)"
export REDIS_PASSWORD="$(read_secret chatwoot_redis_password)"
export SECRET_KEY_BASE="$(read_secret chatwoot_secret_key_base)"
export BAILEYS_PROVIDER_DEFAULT_API_KEY="$(read_secret baileys_api_key_v2)"

exec "$@"
